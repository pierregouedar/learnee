# Copie ce fichier en .env.local (dev) ou .env (Docker) et remplis au moins OPENROUTER_API_KEY.
# Ne commite jamais le fichier rempli : .gitignore exclut tous les .env* sauf celui-ci.

# --- Modèles de langage (via OpenRouter) ---------------------------------------------------------
OPENROUTER_API_KEY=
# Modèle payant pour les générations (sujets, séries, test, scripts d'écoute) et les corrections.
# Liste des modèles : curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id'
LLM_MODEL_GENERATE=openai/gpt-6-luna
LLM_MODEL_CORRECT=openai/gpt-6-luna
# "flex" : tarif OpenAI divisé par deux, plus lent ; sans capacité flex (429), relance au tarif normal.
LLM_SERVICE_TIER=flex
# Tâches légères sur des modèles gratuits. Une variable peut lister plusieurs modèles séparés par des
# virgules : le premier, puis des secours (OpenRouter en accepte 3 par requête).
LLM_MODEL_DEFINE=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
LLM_MODEL_WEEKLY_REPORT=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
LLM_MODEL_LISTENING_CONTEXT=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
# Autres tâches, facultatif (vide = LLM_MODEL_CORRECT, puis LLM_MODEL_GENERATE) :
# LLM_MODEL_GRAMMAR_SET= LLM_MODEL_GRAMMAR_CHECK= LLM_MODEL_REWRITE_CHECK= LLM_MODEL_PLACEMENT=
# LLM_MODEL_LISTENING_SCRIPT= LLM_MODEL_LISTENING_CORRECT=
# Les modèles :free exigent la collecte des données, autorisée automatiquement pour eux seuls.
# true = l'autoriser aussi pour les modèles payants (déconseillé : ce sont les copies de l'élève).
LLM_ALLOW_DATA_COLLECTION=false
# Délai max par appel (ms). Défaut 300000 (5 min).
LLM_TIMEOUT_MS=300000

# --- Audio (ElevenLabs) ---------------------------------------------------------------------------
# Sans clé : créer ou importer une écoute est désactivé (message en français), la prononciation
# utilise la voix du navigateur, le reste fonctionne.
ELEVENLABS_API_KEY=
# 6 à 8 ids de voix aux accents variés, séparés par des virgules. La 1re sert aussi à la prononciation.
# Liste : curl -s https://api.elevenlabs.io/v2/voices -H "xi-api-key: $ELEVENLABS_API_KEY" | jq -r '.voices[] | "\(.voice_id) \(.name)"'
ELEVENLABS_VOICES=
# ELEVENLABS_SCRIBE_MODEL=scribe_v2
# Moteur de l'audio généré : elevenlabs (défaut) ou seed-audio (expérimental, contrôle WER, repli ElevenLabs)
TTS_PROVIDER=elevenlabs
SEED_AUDIO_URL=
SEED_AUDIO_API_KEY=
SEED_AUDIO_MODEL=seed-audio-1.0
SEED_AUDIO_VIA=

# --- Stockage ----------------------------------------------------------------------------------
# Dev uniquement : en Docker, compose force /data/app.db et /data.
DATABASE_PATH=data/app.db
DATA_DIR=data

# --- Proxy de confiance ------------------------------------------------------------------------------
# En-tête qui porte l'IP réelle du visiteur (anti-force brute par IP). Déjà réglé dans les fichiers compose :
# x-forwarded-for derrière Caddy, cf-connecting-ip derrière un tunnel Cloudflare. Vide = aucun en-tête lu : tous les
# visiteurs comptent alors comme une seule IP, et n'importe qui connaissant un identifiant peut bloquer ce compte.
# Ne le renseigner que si l'app n'est joignable QUE par ce proxy : sinon un client l'écrirait lui-même.
TRUSTED_IP_HEADER=

# --- Tâches planifiées ---------------------------------------------------------------------------
# Rien de payant ne tourne tout seul : seules les cartes de verbes irréguliers (sans IA) et le bilan
# du dimanche (modèle gratuit) sont planifiés. false = désactivées.
JOBS_ENABLED=true
# Fuseau des tâches planifiées et du « jour » de l'écran Aujourd'hui.
TZ=Europe/Paris

# --- Bilan hebdomadaire par e-mail (facultatif) ------------------------------------------------------
# Sans SMTP_URL, le bilan reste lisible sur /bilan. Exemple : smtps://utilisateur:motdepasse@smtp.exemple.fr:465
SMTP_URL=
SMTP_FROM=
REPORT_TO=

# --- Déploiement avec Caddy (compose.yaml) ---------------------------------------------------------
# Domaine public servi en HTTPS par Caddy. Inutile derrière un tunnel Cloudflare (voir deploy/nas).
DOMAIN=learnee.example.fr
